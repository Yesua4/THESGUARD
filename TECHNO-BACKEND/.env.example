APP_NAME=ThesisGuard
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=capstone_db
DB_USERNAME=root
DB_PASSWORD=
# Only needed on Windows/XAMPP where mysqldump isn't on PATH — points
# laravel-backup at the directory containing mysqldump.exe.
MYSQLDUMP_PATH=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# "log" just writes emails to storage/logs/laravel.log — fine for local dev.
# For production, switch to smtp and fill in real credentials (e.g. Gmail,
# Mailgun, SES) so notification emails actually reach users.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ── ThesisGuard custom variables ──────────────────────────────────────────────────
# A random string added to passwords before hashing (change this, keep it secret)
PASSWORD_PEPPER=

# Python similarity service URL
SIMILARITY_SERVICE_URL=http://localhost:8001

# Path to the LibreOffice/soffice binary, used to convert uploaded Word
# documents to PDF for in-app preview. Leave blank to auto-detect common
# install locations, or blank entirely to disable preview conversion
# (uploads still work, Word docs just fall back to download-only).
LIBREOFFICE_PATH=

# URL of the React SPA, used to redirect back after Google Sign-In completes.
FRONTEND_URL=http://localhost:5173

# Get these from https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be set there to exactly match GOOGLE_REDIRECT_URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback